# shellcheck shell=sh
# After cockpit-host-settings was removed (as root; also `make uninstall`): forget its units and
# its state, the menu's backups among it. /etc/cockpit-host-settings (the settings, the ntfy token
# and the watchdog's URL) stays, as configuration does, and so does the user cockpit-host-settings:
# removing a system user could hand its id to another one later. Cockpit's override files in
# /etc/cockpit and ~/.config/cockpit stay as well: they are Cockpit's own, and the menu set there
# is the administrator's choice.
# SPDX-License-Identifier: Apache-2.0
for f in last.json status.json heartbeat.json test-ntfy.json test-mail.json test-heartbeat.json .lock; do
    rm -f "/var/lib/cockpit-host-settings/$f"
done
# The versions of Cockpit's override files from before each change for all users (hsmenu.py).
rm -rf /var/lib/cockpit-host-settings/backup
rmdir /var/lib/cockpit-host-settings 2> /dev/null || true
rm -f /run/cockpit-host-settings.lock
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi
