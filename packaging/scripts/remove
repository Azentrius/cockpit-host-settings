# shellcheck shell=sh
# Before cockpit-host-settings is removed (as root; also `make uninstall`): stop its timer and its
# services.
# SPDX-License-Identifier: Apache-2.0
if [ -d /run/systemd/system ]; then
    systemctl disable --now cockpit-host-settings-notify.timer > /dev/null 2>&1 || true
    systemctl stop cockpit-host-settings-notify.service 'cockpit-host-settings-test@*.service' > /dev/null 2>&1 || true
fi
# Bytecode a Python run without -B may have left next to the helpers.
rm -rf /usr/lib/cockpit-host-settings/__pycache__
