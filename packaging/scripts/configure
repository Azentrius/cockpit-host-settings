# shellcheck shell=sh
# After every install and upgrade of cockpit-host-settings (as root; also `make install`).
# SPDX-License-Identifier: Apache-2.0
#
# The notifier's own user (sysusers.d; useradd where systemd-sysusers is missing), its state
# directory, and /etc/cockpit-host-settings with an empty token file and an empty watchdog file:
# the services hand both over with LoadCredential=, which needs the files to exist. The timer stays
# as it was: off on a new install (it is set up from the page), on after an upgrade if it was on.
if command -v systemd-sysusers > /dev/null 2>&1; then
    systemd-sysusers /usr/lib/sysusers.d/cockpit-host-settings.conf || true
elif ! getent passwd cockpit-host-settings > /dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin \
        --comment "Host Settings notifications" cockpit-host-settings || true
fi
install -d -m 755 -o root -g root /etc/cockpit-host-settings
if [ ! -e /etc/cockpit-host-settings/ntfy.token ]; then
    install -m 600 -o root -g root /dev/null /etc/cockpit-host-settings/ntfy.token
fi
if [ ! -e /etc/cockpit-host-settings/heartbeat.conf ]; then
    install -m 600 -o root -g root /dev/null /etc/cockpit-host-settings/heartbeat.conf
fi
if getent passwd cockpit-host-settings > /dev/null 2>&1; then
    install -d -m 755 -o cockpit-host-settings -g cockpit-host-settings /var/lib/cockpit-host-settings
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    if systemctl is-enabled --quiet cockpit-host-settings-notify.timer 2> /dev/null; then
        systemctl restart cockpit-host-settings-notify.timer || true
    fi
fi
